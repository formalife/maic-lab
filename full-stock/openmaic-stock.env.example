# OpenMAIC full-stock lab overlay
# NON-PRODUCTION. Safe to commit because it contains no provider credentials.
# Append this block to the upstream OpenMAIC .env.local.

# --- Full product / authoring ---
NEXT_PUBLIC_PRO_WORKBENCH_ENABLED=true
NEXT_PUBLIC_MAIC_EDITOR_ENABLED=true
OPENMAIC_AGENT_RUNTIME_ENABLED=true

# --- Server-backed local lab state ---
DATABASE_URL=postgres://openmaic:openmaic-dev@postgres:5432/openmaic
PERSISTENCE_DEV_TOKEN=openmaic-local-dev
NEXT_PUBLIC_PERSISTENCE=1
NEXT_PUBLIC_PERSISTENCE_TOKEN=openmaic-local-dev

# --- Learner/runtime features under test ---
NEXT_PUBLIC_PI_CHAT_ENABLED=true
NEXT_PUBLIC_COURSEWARE_REFERENCE_ENABLED=true
OPENMAIC_ENABLE_VOCATIONAL=true
NEXT_PUBLIC_SHOW_VOCATIONAL_TEST_UI=true
NEXT_PUBLIC_ENABLE_PPTX_IMPORT=true

# Keep the newer package renderer experiments OFF for the stock-product baseline.
# The full application currently owns richer legacy playback/editor surfaces.
NEXT_PUBLIC_MAIC_PLAYBACK_RENDERER_ENABLED=false
NEXT_PUBLIC_MAIC_EDITOR_RENDERER_ENABLED=false

# Video export is intentionally excluded from the first baseline because its
# optional render-service profile adds Chromium/FFmpeg and an 8 GiB default
# memory ceiling without helping the first learning-value question.
NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=false

LOG_LEVEL=info
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# MODEL CONFIGURATION
# ---------------------------------------------------------------------------
# Formalife's current baseline is ZERO COST: run Ollama locally on the Mac and
# execute full-stock/configure-ollama.sh. That helper writes the active values
# below into .env.local after selecting and validating a local Qwen3 model.
#
# Example only (the helper chooses the actual tag from available RAM):
# FORMALIFE_ZERO_COST_MODE=1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODELS=qwen3:8b
# DEFAULT_MODEL=ollama:qwen3:8b
# MODEL_ROUTES='{"scene-content":"ollama:qwen3:8b","scene-actions":"ollama:qwen3:8b","maic-agent-driver":{"model":"ollama:qwen3:8b","api":"openai-completions","contextWindow":32768}}'
# ALLOW_LOCAL_NETWORKS=true
#
# IMPORTANT: while OPENMAIC_AGENT_RUNTIME_ENABLED=true, maic-agent-driver is
# mandatory upstream and has no fallback. The zero-cost helper routes all major
# model stages to Ollama so the lab cannot silently use a paid provider.
#
# full-stock/configure-openai.sh remains only as an explicit future alternative;
# it is NOT part of the current Formalife zero-cost path.
