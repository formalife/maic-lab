{
  "name": "@formalife/maic-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Internal non-production Formalife laboratory for selective OpenMAIC experiments.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm prototype:001:preview:data && tsc --noEmit -p preview/tsconfig.json",
    "test": "vitest run",
    "prototype:001:recorded": "tsx scripts/prototype-001-recorded.ts",
    "prototype:001:preview:data": "tsx scripts/prototype-001-preview-data.ts",
    "preview:build": "pnpm prototype:001:preview:data && vite build --config preview/vite.config.ts",
    "preview:dev": "pnpm prototype:001:preview:data && vite --config preview/vite.config.ts"
  },
  "dependencies": {
    "@openmaic/dsl": "0.11.2",
    "@openmaic/generation": "0.3.11",
    "@openmaic/renderer": "0.1.11",
    "motion": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "4.1.8"
  }
}
